# ---- Webhook auth -----------------------------------------------------------
# Shared secret GoKwik must send, either as an X-Webhook-Secret header
# or as a ?secret=... query param. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=replace-with-a-long-random-string

# ---- Dashboard auth (HTTP Basic) -------------------------------------------
# Protects "/" and "/api/carts". The table contains customer PII.
DASHBOARD_USER=briyo
DASHBOARD_PASS=replace-with-a-strong-password

# ---- Postgres ---------------------------------------------------------------
# Provided automatically when you attach a Postgres (Neon) database to the
# project in the Vercel dashboard -> Storage. @vercel/postgres reads POSTGRES_URL
# by default. Vercel injects all of the following; POSTGRES_URL is the only one
# this app actually needs.
#
#   POSTGRES_URL              <- required (pooled connection, used by @vercel/postgres)
#   POSTGRES_URL_NON_POOLING  <- injected, unused here
#   POSTGRES_PRISMA_URL       <- injected, unused here
#   POSTGRES_USER / POSTGRES_HOST / POSTGRES_PASSWORD / POSTGRES_DATABASE
#   DATABASE_URL              <- injected by newer Neon integration, unused here
#
# For local dev, run `vercel env pull .env.local` to copy these down, or paste a
# Neon connection string manually:
POSTGRES_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require
