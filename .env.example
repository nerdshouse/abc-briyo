# Your myshopify domain — no https://, no trailing slash
SHOPIFY_STORE_DOMAIN=briyo-supplements.myshopify.com

# Admin API access token from your custom app (starts with shpat_)
# Leave this blank to run the board in MOCK MODE with sample data.
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin API version
SHOPIFY_API_VERSION=2024-10

# Port for the local server
PORT=3000
