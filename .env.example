# ---- Storage --------------------------------------------------------------
# Neon Postgres connection string. Leave blank to run in MOCK MODE (in-memory
# sample data, reset on restart).
DATABASE_URL=

# ---- GoKwik webhook -------------------------------------------------------
# Shared secret GoKwik must send. Generate: openssl rand -hex 32
# GoKwik's Custom Webhook screen takes only a URL, so give them:
#   https://abc.briyo.xyz/api/webhook/gokwik/abandoned-cart?secret=<this value>
WEBHOOK_SECRET=replace-with-a-long-random-string

# Port for the local server
PORT=3000

# ---- Login (WhatsApp OTP via 11za) -----------------------------------------
# BOOTSTRAP ONLY. The live allowlist is the allowed_users table; this seeds it
# on first boot when that table is empty, and is the fallback if it's unreadable.
# Once the table has rows, editing this has no effect — use SQL (see README).
# Bare numbers, or "Name:number" — the name greets them in the OTP message.
ALLOWED_PHONES=Asha:9812345678,9820011223

# Signs session cookies and hashes OTPs. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# How long a login lasts before re-verification
SESSION_TTL_HOURS=12

# MUST be true in production (https://abc.briyo.xyz); false for local http.
COOKIE_SECURE=false

# ---- 11za WhatsApp API ------------------------------------------------------
# Leave ELEVENZA_AUTH_TOKEN blank to run in console mode, where the OTP is
# printed to the server log instead of sent on WhatsApp.
ELEVENZA_AUTH_TOKEN=
ELEVENZA_TEMPLATE_NAME=login_otp
ELEVENZA_ORIGIN_WEBSITE=https://www.briyosupplements.com//
ELEVENZA_LANGUAGE=en
ELEVENZA_API_URL=https://api.11za.in/apis/template/sendTemplate

# Only set this if 11za also expects a header; the token goes in the body.
# ELEVENZA_AUTH_HEADER=

# Optional full override of the request body. Placeholders:
# {{authToken}} {{name}} {{phone}} {{origin}} {{template}} {{language}} {{otp}}
# ELEVENZA_PAYLOAD_TEMPLATE={"authToken":"{{authToken}}","name":"{{name}}","sendto":"{{phone}}","originWebsite":"{{origin}}","templateName":"{{template}}","language":"{{language}}","data":"{{otp}}"}

# ---- v2: SLA staleness alerting -------------------------------------------
# A cart still at "Not called" after this many hours counts as stale.
SLA_STALE_HOURS=6

# WhatsApp digest of stale carts. Leave OPS_PHONE blank to disable entirely.
OPS_PHONE=
SLA_ALERT_MINUTES=60
SLA_ALERT_THRESHOLD=1
SLA_ALERTS_ENABLED=true

# Alert if no cart webhook arrives for this many hours. The largest genuine gap
# observed in production so far is 3.3h (overnight), so 8 is comfortably clear
# of normal quiet periods while still catching a dead webhook within a workday.
INGEST_SILENCE_HOURS=8

# 11za sends approved TEMPLATES, not free text, so the ops digest needs its own
# approved template with a single body variable. Without this the digest is
# written to the log instead of being sent — it will not reuse login_otp.
ELEVENZA_OPS_TEMPLATE_NAME=

# ---- Keep-alive (free tier sleeps after 15 min idle) ----------------------
KEEPALIVE_ENABLED=true
KEEPALIVE_MINUTES=10
# KEEPALIVE_URL=https://abc.briyo.xyz

# ---- v3 phase 3 -----------------------------------------------------------
# Bump to invalidate every session immediately (emergency global logout).
# Sessions are stateless, so this is the only instant revocation lever.
SESSION_EPOCH=1

# Per-IP cap on OTP requests per hour, on top of the per-phone limit. Protects
# 11za credits and the WhatsApp sender's reputation from number-rotation abuse.
OTP_IP_LIMIT=10
