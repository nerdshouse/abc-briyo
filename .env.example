# Your myshopify domain — no https://, no trailing slash
SHOPIFY_STORE_DOMAIN=briyo-supplements.myshopify.com

# --- Pick ONE of the two auth methods below ---
#
# (a) Dev Dashboard app (required for apps created from 1 Jan 2026 onward).
#     Client ID + secret from dev.shopify.com -> your app -> App settings.
#     The server exchanges these for a 24h token and refreshes automatically.
#     The app and the store must be in the same Shopify organization.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
#
# (b) Legacy custom app created in the store admin before 1 Jan 2026.
#     A permanent token starting shpat_. Takes precedence if set.
SHOPIFY_ACCESS_TOKEN=
#
# Leave both blank to run the board in MOCK MODE with sample data.

# Admin API version
SHOPIFY_API_VERSION=2026-07

# Port for the local server
PORT=3000

# ---- Login (WhatsApp OTP via 11za) -----------------------------------------
# Who may sign in. EMPTY MEANS NOBODY CAN.
# Bare numbers, or "Name:number" — the name is passed to the OTP template.
ALLOWED_PHONES=Asha:9812345678,9820011223

# Signs session cookies and hashes OTPs. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# How long a login lasts before re-verification
SESSION_TTL_HOURS=12

# MUST be true in production (https://abc.briyo.xyz); false for local http.
COOKIE_SECURE=false

# ---- 11za WhatsApp API ------------------------------------------------------
# Leave ELEVENZA_AUTH_TOKEN blank to run in console mode, where the OTP is
# printed to the server log instead of sent on WhatsApp.
ELEVENZA_AUTH_TOKEN=
ELEVENZA_TEMPLATE_NAME=login_otp
ELEVENZA_ORIGIN_WEBSITE=https://www.briyosupplements.com//
ELEVENZA_LANGUAGE=en
ELEVENZA_API_URL=https://api.11za.in/apis/template/sendTemplate

# Only set this if 11za also expects a header; the token goes in the body.
# ELEVENZA_AUTH_HEADER=

# Optional full override of the request body. Placeholders:
# {{authToken}} {{name}} {{phone}} {{origin}} {{template}} {{language}} {{otp}}
# ELEVENZA_PAYLOAD_TEMPLATE={"authToken":"{{authToken}}","name":"{{name}}","sendto":"{{phone}}","originWebsite":"{{origin}}","templateName":"{{template}}","language":"{{language}}","data":"{{otp}}"}
