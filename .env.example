# Your myshopify domain — no https://, no trailing slash
SHOPIFY_STORE_DOMAIN=briyo-supplements.myshopify.com

# Admin API access token from your custom app (starts with shpat_)
# Leave this blank to run the board in MOCK MODE with sample data.
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin API version
SHOPIFY_API_VERSION=2024-10

# Port for the local server
PORT=3000

# ---- Login (WhatsApp OTP via 11za) -----------------------------------------
# Comma-separated list of numbers allowed to sign in. EMPTY MEANS NOBODY CAN.
# 10-digit Indian mobiles; +91 / spaces / leading 0 are all normalised.
ALLOWED_PHONES=9812345678,9820011223

# Signs session cookies and hashes OTPs. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# How long a login lasts before re-verification
SESSION_TTL_HOURS=12

# Set true when served over HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false

# 11za WhatsApp API. Leave ELEVENZA_AUTH_TOKEN blank to run in console mode,
# where the OTP is printed to the server log instead of sent.
ELEVENZA_API_URL=https://api.11za.in/apis/template/sendTemplate
ELEVENZA_AUTH_TOKEN=
ELEVENZA_AUTH_HEADER=authToken
ELEVENZA_TEMPLATE_NAME=your_login_otp_template_name

# Request body sent to 11za. {{phone}}, {{otp}} and {{template}} are substituted.
# Defaults to 11za's documented field names; adjust if `npm run otp:probe` fails.
ELEVENZA_PAYLOAD_TEMPLATE={"TemplateName":"{{template}}","PhoneNumber":"{{phone}}","Language":"en","BodyDynamicData":"{{otp}}"}
